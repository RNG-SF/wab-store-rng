# RNG-SF Environment Configuration Template
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# PostgreSQL Database Configuration
SQL_HOST="localhost"
SQL_PORT=5432
SQL_DB_NAME="rng_sf_db"
SQL_USER="rng_user"
SQL_PASSWORD="YOUR_DATABASE_PASSWORD"
SQL_ADMIN_USER="rng_admin"
SQL_ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"

# Authentication & Security
JWT_SECRET="GENERATE_A_STRONG_RANDOM_SECRET_KEY_FOR_JWT"
SESSION_COOKIE_SECRET="GENERATE_A_STRONG_RANDOM_SECRET_KEY_FOR_COOKIES"

# Super Admin / Owner Bootstrap Credentials
OWNER_INITIAL_PASSWORD="SET_SECURE_INITIAL_OWNER_PASSWORD_HERE"
OWNER_EMAIL="sofyantorangga028@gmail.com"
OWNER_USERNAME="Rangga"

# Payment Gateway Configuration
PAYMENT_GATEWAY_PROVIDER="QRIS_DEV" # Options: MIDTRANS | STRIPE | XENDIT | QRIS_DEV
WEBHOOK_SECRET_KEY="GENERATE_HMAC_SHA256_WEBHOOK_SECRET"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# Media Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=50

# AI Studio injected variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
